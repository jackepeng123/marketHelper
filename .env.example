# ========================
# 数据库配置
# ========================
# PostgreSQL 数据库配置
POSTGRES_DB=markethelper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# 数据库连接 URL (Docker 内部使用)
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/markethelper

# ========================
# Redis 配置
# ========================
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@redis:6379

# ========================
# API Keys (请填写您的真实密钥)
# ========================
# DeepSeek AI API
DEEPSEEK_API_KEY=

# 高德地图 API
AMAP_KEY=

# 和风天气 API
QWEATHER_HOST=
QWEATHER_KEY=

# Manus API
MANUS_API_KEY=

# 抖音开放平台
CLIENT_KEY=
CLIENT_SECRET=
ACCOUNT_ID=
POI_ID=

# 百度千帆 API
QIANFAN_ACCESS_KEY=
QIANFAN_SECRET_KEY=

# ========================
# Nacos 配置中心 (可选)
# ========================
NACOS_SERVER_ADDR=
NACOS_NAMESPACE=
NACOS_USERNAME=
NACOS_PASSWORD=

# ========================
# Phoenix 监控配置
# ========================
# 是否自动启动 Phoenix Server (1=启动, 0=不启动)
PHOENIX_AUTO_START=1
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_SQL_DATABASE_SCHEMA=phoenix

# Phoenix Collector Endpoint (如果使用外部 Phoenix，取消注释)
# PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
